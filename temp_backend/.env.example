# ─────────────────────────────────────────────────────────────────────────────
# Backend environment — copy this file to `.env` (in temp_backend/) and fill in.
# `.env` is gitignored: every developer keeps their own; production uses the
# host's dashboard (e.g. Render env vars), not a file.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: database ──────────────────────────────────────────────────────
# Any Postgres — local, Neon, Render, etc. Tables auto-create on first boot.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require

# ── REQUIRED: auth ──────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ── REQUIRED for LOGIN: Channel-i OAuth (IITR-issued; get from the team) ─────
# Without these the app runs, but users can't log in via Channel-i.
authoriseURL=https://channeli.in/oauth/authorise/
token_URL=https://channeli.in/open_auth/token/
get_user_data_url=https://channeli.in/open_auth/get_user_data/
client_id=<your_channeli_client_id>
client_secret_id=<your_channeli_client_secret>
# Local dev only. In production behind CloudFront this must be
# https://<cloudfront-domain>/api/oauth/token/ — the /api prefix matters, see docs/DEPLOY_RUNBOOK.md P6.
redirectURL=http://127.0.0.1:8081/oauth/token/
# The SPA is mounted at /app/ (Router basename in src/App.jsx, `base` in vite.config.js), so a
# redirect to /home lands on a 404 — you log in successfully and see nothing.
FRONTEND_REDIRECT_URL=http://127.0.0.1:5173/app/home

# ── Server / CORS ───────────────────────────────────────────────────────────
PORT=8081
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
# CORS_ALLOWED_ORIGIN_REGEX=

# ── Admin permissions ────────────────────────────────────────────────────────
# No longer configured here. Permission ids used to live in six *_PERMISSION_ID vars, but ids do not
# vary between deploys (manage_clubs is 6 everywhere), so they were never deployment config — and an
# environment could silently contradict the code. Migration 20260805000000 seeds the rows with fixed
# ids, and utils/permissions.js resolves them BY NAME at boot. Nothing to set.
# The academic-calendar admin gate is SUPER-ADMIN ONLY (the `manage_admins` permission).

# ── OPTIONAL: Groq assist for the academic-calendar parser ──────────────────
# Leave unset → the parser runs 100% deterministic (no AI). Set both to enable
# the sandboxed assist (outlier-date suggestions + classifier tie-break).
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_free_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# ── OPTIONAL: Poster OCR (Gemini Vision) for event ingestion ─────────────────
# Reads event POSTERS for the date/venue the email TEXT didn't have. Leave unset
# → ingestion runs normally with no poster reading. Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_free_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash

# ── OPTIONAL: dev/ops flags ─────────────────────────────────────────────────
# DEV_LOGIN=true            # enables /oauth/dev-login (local admin, no Channel-i). NEVER set in prod
#                           #   (in production the route isn't even registered + boot fail-closes).
# RESET_DB=false            # true = DROP all tables on boot (dev only — HARD-DISABLED in production)
# ACAL_DEBUG=1              # verbose logging for the calendar PDF parser
# TEST_DATABASE_URL=        # throwaway DB for the DB integration test

# ── PRODUCTION prod-readiness (mostly optional; sensible defaults) ────────────
# LOG_LEVEL=info                 # pino level: debug|info|warn|error (default: info in prod, debug in dev)
# SENTRY_DSN=                    # enables Sentry error alerting + poller cron; unset = disabled
# SENTRY_ENV=production
# DB_STATEMENT_TIMEOUT_MS=30000  # kill a single query after this (tune with the stress test)
# DB_IDLE_TXN_TIMEOUT_MS=30000   # kill an idle-in-transaction session holding locks
# DB_POOL_MAX=10                 # Sequelize pool size (keep under RDS max_connections)
# Poster storage: set these in prod so posters go to S3 (durable) instead of local disk.
# POSTER_S3_BUCKET=              # unset = fall back to local uploads/posters (dev)
# POSTER_PUBLIC_BASE=           # CloudFront domain fronting the poster bucket, e.g. https://xxxx.cloudfront.net
# AWS_REGION=ap-south-1
# INGEST_PUBLIC_BASE=           # base URL for local-disk poster URLs (when S3 is not used)
